# Copy to backend/.env and adjust if needed
APP_NAME=voiceops
APP_VERSION=0.1.0
ENVIRONMENT=development
ASSEMBLYAI_API_KEY=your_assemblyai_api_key
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com/v1
VOICE_AGENT_WS_URL=wss://agents.assemblyai.com/v1/ws
VOICE_NAME=ivy
DATABASE_URL=sqlite:///./voiceops.db
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
DEBUG=false

# CORS (origine(s) du frontend, séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false

# Rate limiting par IP (désactivable pour les tests)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=100
RATE_LIMIT_VOICE_RPM=30
RATE_LIMIT_WINDOW_SECONDS=60

# Résilience AssemblyAI
ASSEMBLYAI_TIMEOUT_SECONDS=30.0
ASSEMBLYAI_MAX_RETRIES=3
ASSEMBLYAI_RETRY_BACKOFF=1.0
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN=30.0

# Outils / simulateur
TOOL_TIMEOUT_SECONDS=10.0
SIMULATE_LATENCY=false

# SQLite / pooling
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_BUSY_TIMEOUT_MS=5000